# Copie para ".env" e preencha. NUNCA suba o .env para o GitHub.

# --- WhatsApp Business Cloud API (painel da Meta for Developers) ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Texto qualquer que você inventa; o mesmo valor é digitado no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=
# "App Secret" do app na Meta (usado para validar a assinatura dos eventos)
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_INATIVIDADE=aluna_inativa
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR

# --- Banco (só necessário fora do docker-compose) ---
# DB_URL=jdbc:postgresql://localhost:5432/estudio
# DB_USER=estudio
# DB_PASSWORD=estudio
